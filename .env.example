# Copy using make setup: generates local-only random passwords in ignored .env.
# Never commit .env. Production secrets must be supplied by deployment secret management.
AEGIS_PROFILE=dev
AEGIS_LOG_LEVEL=INFO
# Required by Compose. Empty deliberately; setup fills these using secure randomness.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Host API settings (Compose overrides with private service DNS and credentials).
# Use postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
AEGIS_DATABASE_URL=
# Use redis://:PASSWORD@HOST:PORT/0 or rediss:// for TLS.
AEGIS_REDIS_URL=
AEGIS_DEPENDENCY_TIMEOUT_SECONDS=2
# Public browser configuration only; empty means same-origin /health via proxy.
VITE_API_BASE_URL=

# Phase 2 labs use Vite DEV only; no additional runtime configuration.

# Public website build settings. Set the real HTTPS origin before publication.
VITE_SITE_URL=http://localhost:5173
# Public disclosure email; leave blank until a verified address is available.
VITE_SECURITY_CONTACT=

# Prometheus/Grafana scaffolding uses file provisioning; no additional variables.

# Phase 4 reuses AEGIS_DATABASE_URL; no new runtime secrets are required.
# Cursor signing is an internal primitive only; configure a managed key when
# authenticated list routes are implemented. Never expose database records directly.

# Phase 5: same-origin browser authentication. Match the browser origin exactly.
# Production requires https and Secure cookies; localhost development uses http.
AEGIS_APP_ORIGIN=http://localhost:5173
AEGIS_COOKIE_SECURE=false
AEGIS_ACCESS_SECONDS=600
AEGIS_REFRESH_DAYS=30
AEGIS_RESET_MINUTES=30
# Shared Redis window: 10 authentication attempts per peer IP/email per 5 minutes.
AEGIS_AUTH_RATE_LIMIT=10
# Optional SMTP delivery. Blank host sends nothing; never prints recovery/invite links.
# Use a local mail catcher for development, or authenticated STARTTLS in production.
AEGIS_SMTP_HOST=
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USERNAME=
AEGIS_SMTP_PASSWORD=
AEGIS_SMTP_SENDER=noreply@localhost
AEGIS_SMTP_STARTTLS=true

# Phase 6 local-only Fernet key (32 random bytes, URL-safe base64 encoded).
# Keep stable to decrypt saved references. Never commit the key; back it up securely.
# Local provider is refused in production; a managed provider is a later phase.
AEGIS_LOCAL_SECRET_KEY=

# Phase 7: mock-only orchestration. Default missing provider fails visibly.
# Mock fixtures require demo mode (or test profile), and are refused in production.
AEGIS_SCANNER_PROVIDER=none
AEGIS_DEMO_MODE=false
AEGIS_SCAN_COORDINATOR_ENABLED=true
AEGIS_SCAN_CONCURRENCY=3
AEGIS_SCAN_DAILY_QUOTA=100
AEGIS_SCAN_STAGE_TIMEOUT_SECONDS=30

# Phase 8: real scans are opt-in. Never point the scanner socket at an API host.
# Generate separate Fernet keys with scripts/configure_scanner.py (not stdout).
AEGIS_ZAP_DISPATCH_KEY=
AEGIS_ZAP_ARTIFACT_KEY=
AEGIS_ZAP_ALLOWLIST=[]
AEGIS_ZAP_EGRESS_NETWORK=bridge
AEGIS_SCANNER_SOCKET=
AEGIS_SCANNER_SOCKET_GID=
# Worker-only secret key uses AEGIS_LOCAL_SECRET_KEY via scanner Compose overlay.
# Internet active scans are always refused, even when an origin is allowlisted.

# Phase 9: normalization runs automatically inside the configured ZAP worker.
# Reuses worker-only artifact encryption/redaction settings; no new secrets or flags.
# API receives masked observations only and never receives the artifact decryption key.

# Phase 10: explicit on-demand advisory enrichment; none makes no provider calls.
# mock requires test profile or local DEMO_MODE, and is rejected in production.
AEGIS_AI_PROVIDER=none
AEGIS_AI_MODEL=gemini-2.5-flash
AEGIS_GEMINI_API_KEY=
