          "created_at",
          "updated_at",
          "target_id",
          "title",
          "scanner_severity",
          "state"
        ],
        "title": "FindingSummary",
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "title": "Page",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "informational",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "items": {
          "$ref": "#/$defs/FindingSummary"
        },
        "title": "Data",
        "type": "array"
      },
      "page": {
        "$ref": "#/$defs/Page"
      },
      "request_id": {
        "format": "uuid",
        "title": "Request Id",
        "type": "string"
      }
    },
    "required": [
      "data",
      "page",
      "request_id"
    ],
    "title": "Collection[FindingSummary]",
    "type": "object"
  },
  "FindingQuery": {
    "$defs": {
      "FindingState": {
        "enum": [
          "new",
          "recurring",
          "changed",
          "resolved",
          "accepted_risk",
          "false_positive"
        ],
        "title": "FindingState",
        "type": "string"
      },
      "Severity": {
        "enum": [
          "informational",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "anyOf": [
          {
            "maxLength": 2048,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "cwe": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cwe"
      },
      "limit": {
        "default": 25,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "order": {
        "default": "-created_at",
        "enum": [
          "created_at",
          "-created_at"
        ],
        "title": "Order",
        "type": "string"
      },
      "severity": {
        "anyOf": [
          {
            "$ref": "#/$defs/Severity"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "state": {
        "anyOf": [
          {
            "$ref": "#/$defs/FindingState"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "target_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Id"
      }
    },
    "title": "FindingQuery",
    "type": "object"
  }
}
