{
  "ErrorResponse": {
    "$defs": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/$defs/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "title": "ErrorDetail",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "error": {
        "$ref": "#/$defs/Error"
      }
    },
    "required": [
      "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
  },
  "EventCollection": {
    "$defs": {
      "EventSummary": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "message_code": {
            "title": "Message Code",
            "type": "string"
          },
          "scan_id": {
            "format": "uuid",
            "title": "Scan Id",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "stage": {
            "$ref": "#/$defs/ScanState"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "scan_id",
          "sequence",
          "stage",
          "message_code",
          "attempt"
        ],
        "title": "EventSummary",
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "title": "Page",
        "type": "object"
      },
      "ScanState": {
        "enum": [
          "draft",
          "queued",
          "validating_target",
          "preparing_scanner",
          "spidering",
          "passive_scanning",
          "active_scanning",
          "collecting_results",
          "normalizing",
          "enriching",
          "evaluating_policy",
          "generating_report",
          "completed",
          "failed",
          "cancelled",
          "timed_out"
        ],
        "title": "ScanState",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "items": {
          "$ref": "#/$defs/EventSummary"
        },
        "title": "Data",
        "type": "array"
      },
      "page": {
        "$ref": "#/$defs/Page"
      },
      "request_id": {
        "format": "uuid",
        "title": "Request Id",
        "type": "string"
      }
    },
    "required": [
      "data",
      "page",
      "request_id"
    ],
    "title": "Collection[EventSummary]",
    "type": "object"
  },
  "EventQuery": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "anyOf": [
          {
            "maxLength": 2048,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "limit": {
        "default": 25,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "order": {
        "default": "-created_at",
        "enum": [
          "created_at",
          "-created_at"
        ],
        "title": "Order",
        "type": "string"
      },
      "scan_id": {
        "format": "uuid",
        "title": "Scan Id",
        "type": "string"
      }
    },
    "required": [
      "scan_id"
    ],
    "title": "EventQuery",
    "type": "object"
  },
  "FindingCollection": {
    "$defs": {
      "FindingState": {
        "enum": [
          "new",
          "recurring",
          "reopened",
          "changed",
          "resolved",
          "accepted_risk",
          "false_positive"
        ],
        "title": "FindingState",
        "type": "string"
      },
      "FindingSummary": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "scanner_severity": {
            "$ref": "#/$defs/Severity"
          },
          "state": {
            "$ref": "#/$defs/FindingState"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "target_id",
          "title",
          "scanner_severity",
          "state"
        ],
        "title": "FindingSummary",
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "title": "Page",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "informational",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "data": {
        "items": {
          "$ref": "#/$defs/FindingSummary"
        },
        "title": "Data",
        "type": "array"
      },
      "page": {
        "$ref": "#/$defs/Page"
      },
      "request_id": {
        "format": "uuid",
        "title": "Request Id",
        "type": "string"
      }
    },
    "required": [
      "data",
      "page",
      "request_id"
    ],
    "title": "Collection[FindingSummary]",
    "type": "object"
  },
  "FindingQuery": {
    "$defs": {
      "FindingState": {
        "enum": [
          "new",
          "recurring",
          "reopened",
          "changed",
          "resolved",
          "accepted_risk",
          "false_positive"
        ],
        "title": "FindingState",
        "type": "string"
      },
      "Severity": {
        "enum": [
          "informational",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "anyOf": [
          {
            "maxLength": 2048,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "cwe": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cwe"
      },
      "limit": {
        "default": 25,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "order": {
        "default": "-created_at",
        "enum": [
          "created_at",
          "-created_at"
        ],
        "title": "Order",
        "type": "string"
      },
      "severity": {
        "anyOf": [
          {
            "$ref": "#/$defs/Severity"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "state": {
        "anyOf": [
          {
            "$ref": "#/$defs/FindingState"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "target_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Id"
      }
    },
    "title": "FindingQuery",
    "type": "object"
  },
  "ReportSnapshot": {
    "$defs": {
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "ai_analysis_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Ai Analysis Ids",
            "type": "array"
          },
          "ai_label": {
            "const": "Advisory AI guidance; not scanner evidence",
            "default": "Advisory AI guidance; not scanner evidence",
            "title": "Ai Label",
            "type": "string"
          },
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "finding_id": {
            "format": "uuid",
            "title": "Finding Id",
            "type": "string"
          },
          "occurrence_id": {
            "format": "uuid",
            "title": "Occurrence Id",
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          }
        },
        "required": [
          "finding_id",
          "occurrence_id",
          "artifact_id",
          "severity",
          "ai_analysis_ids"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "informational",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "captured_at": {
        "format": "date-time",
        "title": "Captured At",
        "type": "string"
      },
      "completeness": {
        "title": "Completeness",
        "type": "string"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "evaluation_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Evaluation Id"
      },
      "evaluation_input_digest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Evaluation Input Digest"
      },
      "evaluation_version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Evaluation Version"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/Evidence"
        },
        "title": "Evidence",
        "type": "array"
      },
      "finished_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Finished At"
      },
      "gate_policy_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Gate Policy Id"
      },
      "limitations": {
        "items": {
          "type": "string"
        },
        "title": "Limitations",
        "type": "array"
      },
      "organization_id": {
        "format": "uuid",
        "title": "Organization Id",
        "type": "string"
      },
      "policy_id": {
        "format": "uuid",
        "title": "Policy Id",
        "type": "string"
      },
      "policy_result": {
        "enum": [
          "pass",
          "warn",
          "fail",
          "incomplete"
        ],
        "title": "Policy Result",
        "type": "string"
      },
      "policy_version": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Policy Version"
      },
      "project_id": {
        "format": "uuid",
        "title": "Project Id",
        "type": "string"
      },
      "redaction_notice": {
        "default": "Redacted: credentials, headers, cookies, response bodies and free-form scanner text are excluded. Evidence references require authorization in AegisForge.",
        "title": "Redaction Notice",
        "type": "string"
      },
      "scan_id": {
        "format": "uuid",
        "title": "Scan Id",
        "type": "string"
      },
      "scan_state": {
        "title": "Scan State",
        "type": "string"
      },
      "scanner_versions": {
        "items": {
          "type": "string"
        },
        "title": "Scanner Versions",
        "type": "array"
      },
      "schema_version": {
        "const": "report-v1",
        "default": "report-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "severity_summary": {
        "additionalProperties": {
          "type": "integer"
        },
        "propertyNames": {
          "$ref": "#/$defs/Severity"
        },
        "title": "Severity Summary",
        "type": "object"
      },
      "started_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Started At"
      },
      "target_id": {
        "format": "uuid",
        "title": "Target Id",
        "type": "string"
      }
    },
    "required": [
      "organization_id",
      "scan_id",
      "project_id",
      "target_id",
      "policy_id",
      "policy_version",
      "evaluation_id",
      "scanner_versions",
      "scan_state",
      "completeness",
      "created_at",
      "started_at",
      "finished_at",
      "captured_at",
      "severity_summary",
      "evidence",
      "policy_result",
      "limitations"
    ],
    "title": "Snapshot",
    "type": "object"
  }
}
